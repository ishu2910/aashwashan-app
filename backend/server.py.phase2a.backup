async def log_activity(db: AsyncSession, user_id, action, metadata=None):
    await db.execute(
        text("""
            INSERT INTO user_activity (user_id, action, metadata)
            VALUES (:user_id, :action, :metadata)
        """),
        {
            "user_id": user_id,
            "action": action,
            "metadata": json.dumps(metadata or {})   # 👈 FIX
        }
    )
    await db.commit()

