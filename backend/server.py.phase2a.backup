async def log_activity(db, user_id: str, action: str, details: str = None):
    from sqlalchemy import text

    await db.execute(
        text("""
            INSERT INTO user_activity (id, user_id, action, details)
            VALUES (gen_random_uuid(), :user_id, :action, :details)
        """),
        {
            "user_id": user_id,
            "action": action,
            "details": details
        }
    )
    await db.commit()



